# Keep experiment evidence commit-friendly. Raw data, indexes, and truth sets
# are reproducible from inventory/commands and are too large for git.
**/data/
**/indexes/
**/truth/
**/tmp/
**/*.bin
**/*.fbin
**/*.bvecs
**/*.ivecs
**/*.fvecs
**/*.index
**/*.spmat
**/*.npy
**/*.npz
**/*.tar
**/*.tar.gz
**/*.zip
**/*.zst

# Keep small provenance, raw jsonl/csv, logs, figures, and summaries.
!**/raw/
!**/raw/**/*.jsonl
!**/raw/**/*.csv
!**/logs/
!**/logs/**/*.log
!**/evidence/
!**/evidence/**/*.json
!**/evidence/**/*.md
!**/figures/
!**/figures/**/*.png
!**/figures/**/*.pdf
!**/*.json
!**/*.md
