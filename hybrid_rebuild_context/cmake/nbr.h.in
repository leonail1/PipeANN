#ifndef NBR_H_
#define NBR_H_

#include "@PIPEANN_ROOT@/include/nbr/abstract_nbr.h"
#include "@PIPEANN_ROOT@/include/nbr/dummy_nbr.h"
#include "@PIPEANN_ROOT@/include/nbr/pq_nbr.h"

namespace pipeann {
  template<typename T>
  inline AbstractNeighbor<T> *get_nbr_handler(Metric metric, const std::string &nbr_type) {
    if (nbr_type == "pq") {
      return new PQNeighbor<T>(metric);
    }
    if (nbr_type == "dummy") {
      return new DummyNeighbor<T>(metric);
    }

    LOG(ERROR) << "Neighbor type '" << nbr_type
               << "' is not available in hybrid_rebuild_context standalone build. "
               << "Supported types: pq, dummy.";
    return nullptr;
  }
}  // namespace pipeann

#endif  // NBR_H_
