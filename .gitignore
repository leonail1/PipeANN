indices/
.cache/
data/*
data-example/*
figures/*
scripts/tests-pipeann/drop_cache
pipeann/*.so
__pycache__/
pipeann.egg-info/
dist/
docs/**/.*
assets/
.codex

# PPT outputs: keep only LaTeX source and compiled PDFs under the PPT directory.
PPT/**/*
!PPT/
!PPT/**/
!PPT/**/*.tex
!PPT/**/*.pdf
